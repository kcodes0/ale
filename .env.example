# Optional for local `npx poke tunnel` / Poke Integrations. Recommended for direct public HTTPS/domain deployments.
# Poke MCP can pass it with: npx poke mcp add ... --api-key $PI_CLOUD_API_KEY
# PI_CLOUD_API_KEY=change-me

# Use false for local Poke tunnel / Poke Integrations. Use true for direct public MCP URLs.
PI_CLOUD_REQUIRE_MCP_AUTH=false

# Poke notifications. The service uses the poke npm SDK to send completion/failure updates.
POKE_API_KEY=your_poke_api_key_here

# Comma-separated allowlist. Either owner/repo or owner/repo=https://custom-git-url.git
ALLOWED_REPOS=acme/web,acme/api=https://github.com/acme/api.git

# Workspace/log storage
WORKSPACES_DIR=.pi-cloud/workspaces
LOGS_DIR=.pi-cloud/logs

# Queue/safety limits
MAX_CONCURRENT_JOBS=1
MAX_RUNTIME_MS=1800000

# Sandbox runner. Recommended: build/provide an image with git, pi CLI, auth, and any repo toolchains installed.
PI_CLOUD_USE_DOCKER=true
PI_AGENT_IMAGE=pi-agent:latest
PI_RUNNER_COMMAND=pi -p "$PI_TASK_PROMPT"

# Optional: carry pi OAuth/API-key config into Docker workers.
# Run pi /login on the host/service user first; tokens live in $PI_AGENT_HOME/agent/auth.json.
# The directory is mounted at /home/pi/.pi inside the worker.
PI_AGENT_HOME=/home/pi-cloud/.pi

# Optional, passed into the worker container for GitHub actions/PRs. Use a fine-scoped token.
GITHUB_TOKEN=your_fine_scoped_github_token_here

# Local development only. Do not use in production.
# PI_CLOUD_USE_DOCKER=false
# PI_CLOUD_ALLOW_UNSANDBOXED=true
